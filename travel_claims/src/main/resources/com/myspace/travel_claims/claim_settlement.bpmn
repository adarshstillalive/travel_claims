      <bpmn2:incoming>_36DCD741-FE7A-5C0B-98D5-363ECFE858FB</bpmn2:incoming>
      <bpmn2:outgoing>_717F697C-99D0-5281-9326-7A1F8F2C6589</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("cid:"+kcontext.getVariable("cid")+",node:"+kcontext.getNodeInstance().getNodeName()+",process:"+kcontext.getProcessInstance().getProcessName());
System.setProperty("jbpm.loop.level.disabled","true");

//Set Base Path
String baseUrl = "https://sandbox.neutrinos-apps.com";

//Set API Method and Content Type
kcontext.setVariable("method","POST");
kcontext.setVariable("contentType","application/json");
kcontext.setVariable("isHandleResponseErrors","true");

//Set API Url
kcontext.setVariable("url", baseUrl + "/claims/api/v1/payout/calculate");

//Payload
String payload = "{" + "\"cid\":\"" + String.valueOf(kcontext.getVariable("cid")) + "\"" + ",\"claimId\":\"" + String.valueOf(kcontext.getVariable("claimId")) + "\"" + ",\"policyNumber\":\"" + String.valueOf(kcontext.getVariable("policyNumber")) + "\"" + "}";
kcontext.setVariable("payload", payload);
kcontext.setVariable("channel","claims");]]></bpmn2:script>
    </bpmn2:scriptTask>
